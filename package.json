{
	"name": "frontend",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run package",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "npm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"deploy": "npm run build && npx gh-pages -d build -t true"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.6.0",
		"@storybook/addon-docs": "^10.6.7",
		"@storybook/addon-svelte-csf": "^5.1.6",
		"@storybook/svelte": "^10.6.7",
		"@storybook/sveltekit": "^10.6.7",
		"@sveltejs/kit": "^3.2.1",
		"@sveltejs/package": "^3.0.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^24.19.2",
		"@types/three": "^0.170.0",
		"autoprefixer": "^10.6.2",
		"mdsvex": "^0.12.8",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"publint": "^0.3.25",
		"storybook": "^10.6.7",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"vite": "^8.3.8"
	},
	"dependencies": {
		"@inlang/paraglide-js": "^3.2.2",
		"@sveltejs/adapter-static": "^4.0.1",
		"@tabler/icons-svelte": "^3.52.0",
		"@tailwindcss/typography": "^0.5.20",
		"gh-pages": "^6.3.0",
		"tailwind-merge": "^3.7.0",
		"three": "^0.170.0",
		"uuid": "^11.1.1"
	},
	"overrides": {
		"@tailwindcss/typography": {
			"postcss-selector-parser": "^6.1.5"
		}
	}
}
